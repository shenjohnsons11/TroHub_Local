PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trohub
MONGODB_DATABASE=trohub
JWT_SECRET=replace-with-a-strong-random-secret
VIETQR_BANK_ID=your-bank-id
VIETQR_ACCOUNT_NO=your-account-number
VIETQR_ACCOUNT_NAME=your-account-name
VQR_BASIC_USERNAME=your-vietqr-username
VQR_BASIC_PASSWORD=your-vietqr-password
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_SECRET_KEY=your-vnpay-secret-key
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay_return
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-from-address
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LANDLORD_API_KEY=your-gemini-landlord-api-key
GEMINI_TENANT_API_KEY=your-gemini-tenant-api-key

