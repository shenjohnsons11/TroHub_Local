{
  "expo": {
    "name": "TroHub",
    "slug": "TroHub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trohub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*",
      "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*.ttf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.TroHub",
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép TroHub dùng camera để quét CCCD và đồng hồ điện nước.",
        "NSSpeechRecognitionUsageDescription": "Cho phép TroHub chuyển giọng nói thành văn bản.",
        "NSMicrophoneUsageDescription": "Cho phép TroHub dùng micro để nhận diện giọng nói."
      }

    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TroHub",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép TroHub dùng micro để nhận diện giọng nói.",
          "speechRecognitionPermission": "Cho phép TroHub chuyển giọng nói thành văn bản."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép TroHub dùng camera để quét CCCD.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_3d_glass.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#04100e",
          "dark": {
            "backgroundColor": "#04100e"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {}
        },
        "projectId": "0677cea0-a643-4813-b6ee-b42aa8a3feab"
      }
    },
    "owner": "shenpen1669"
  }
}
